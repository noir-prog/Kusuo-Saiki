import re, json, time, urllib.request, urllib.parse
from pathlib import Path

base = Path("work/extracted/Jerry'sColRP/texts")
en_file = base / "en_US.lang"
ru_file = base / "ru_RU.lang"
progress_file = Path("work/translation_progress.json")

def parse(lines):
    result = {}
    for line in lines:
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            result[k.strip()] = v.strip()
    return result

en_lines = en_file.read_text(encoding="utf-8-sig").splitlines()
ru_lines = ru_file.read_text(encoding="utf-8-sig").splitlines()
en, ru = parse(en_lines), parse(ru_lines)

progress = {}
if progress_file.exists():
    progress = json.loads(progress_file.read_text(encoding="utf-8"))

token_pattern = re.compile(
    r'https?://\S+|§[0-9a-fk-or]|'
    r'%(?:\d+\$)?[-+#0 ]*(?:\d+)?(?:\.\d+)?[a-zA-Z]|'
    r'\{[^{}]+\}|<[^<>]+>'
)

def translate(text):
    tokens = []
    def protect(match):
        marker = f"ZZTOKEN{len(tokens):04d}ZZ"
        tokens.append((marker, match.group(0)))
        return marker

    protected = token_pattern.sub(protect, text)

    params = {
        "client": "gtx", "sl": "auto", "tl": "ru",
        "dt": "t", "q": protected
    }
    url = "https://translate.googleapis.com/translate_a/single?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})

    for attempt in range(5):
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                data = json.loads(response.read().decode("utf-8"))
            result = "".join(part[0] for part in data[0] if part[0])

            for marker, original in tokens:
                if marker not in result:
                    raise ValueError("Переводчик изменил защищённый маркер")
                result = result.replace(marker, original)

            return result
        except Exception:
            if attempt == 4:
                raise
            time.sleep(3 * (attempt + 1))

todo = [
    (key, value)
    for key, value in en.items()
    if key in ru and value == ru[key]
    and re.search(r'[A-Za-z]', value)
    and key not in progress
]

print("Осталось перевести:", len(todo), flush=True)

for index, (key, value) in enumerate(todo, 1):
    translated = translate(value)
    progress[key] = translated
    progress_file.write_text(
        json.dumps(progress, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )

    if index % 25 == 0 or index == len(todo):
        print(f"Переведено в этом запуске: {index}/{len(todo)}", flush=True)

    time.sleep(0.3)

# Собираем новый русский файл, сохраняя ключи и комментарии
output = []
for line in ru_lines:
    if "=" not in line or line.lstrip().startswith("#"):
        output.append(line)
        continue

    key, old_value = line.split("=", 1)
    key_clean = key.strip()

    if key_clean in progress and key_clean in en and old_value.strip() == en[key_clean]:
        output.append(key + "=" + progress[key_clean])
    else:
        output.append(line)

result_file = base / "ru_RU.translated.lang"
result_file.write_text("\n".join(output) + "\n", encoding="utf-8")

print("\nПЕРЕВОД ЗАВЕРШЁН.")
print("Новый файл:", result_file)
print("Всего сохранено переводов:", len(progress))
print("Исходный ru_RU.lang не изменён.")
